# syntax=docker/dockerfile:1
FROM wordpress:apache

# wordpress:apache (rolling tag, PHP 8.3) already ships imagick, exif, zip
# and OPcache; yac is compiled with --enable-igbinary so it can use the
# igbinary serializer (smaller cached values, less shared-memory use).
# PHP ini overrides live in conf/apache-yac/ and COPY after this layer so
# config-only changes do not recompile extensions.
RUN --mount=type=cache,target=/tmp/pear,sharing=locked \
	set -eux; \
	pecl install igbinary; \
	docker-php-ext-enable igbinary; \
	pecl download yac; \
	yacTar="$(find . -maxdepth 1 -name 'yac-*.tgz' -print -quit)"; \
	[ -n "$yacTar" ]; \
	mkdir -p /usr/src/php/ext/yac; \
	tar --extract --file "$yacTar" --strip-components=1 --directory /usr/src/php/ext/yac; \
	rm "$yacTar"; \
	docker-php-ext-configure yac --enable-igbinary; \
	docker-php-ext-install -j "$(nproc)" yac; \
	rm -rf /usr/src/php/ext/yac

COPY conf/apache-yac/*.ini /usr/local/etc/php/conf.d/

RUN set -eux; \
	php -m | grep -E '^(yac|igbinary|imagick|exif|zip|Zend OPcache)$'; \
	# max_execution_time is pinned to 0 by the CLI SAPI, so verify the config file instead of the runtime value (it applies under Apache SAPI)
	grep -q '^max_execution_time=60$' /usr/local/etc/php/conf.d/zz-wordpress.ini; \
	php -r 'foreach (["opcache.enable"=>"1","opcache.memory_consumption"=>"256","opcache.interned_strings_buffer"=>"32","opcache.max_accelerated_files"=>"20000","opcache.validate_timestamps"=>"1","opcache.revalidate_freq"=>"2","opcache.save_comments"=>"1","opcache.enable_file_override"=>"0","opcache.jit"=>"1255","opcache.jit_buffer_size"=>"128M","yac.enable"=>"1","yac.keys_memory_size"=>"4M","yac.values_memory_size"=>"64M","yac.serializer"=>"igbinary","memory_limit"=>"256M","upload_max_filesize"=>"64M","post_max_size"=>"80M","max_input_vars"=>"3000","realpath_cache_size"=>"4096K","realpath_cache_ttl"=>"600"] as $k=>$v) { if (ini_get($k) !== $v) { fwrite(STDERR, "$k=".ini_get($k)." expected $v\n"); exit(1); } }'
